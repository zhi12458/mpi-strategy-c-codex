  "change_summary": "Add mandatory source-bound Chinese semantic segmentation before drafting and a resumable post-translation native-English editing route for existing bilingual manuscripts. The post-edit route reuses exact-hash upstream evidence, does not rerun complete translation or bilingual review by default, adds expert-derived oral-talk style and human-feedback learning gates, expands commissioner-sensitive changes, and locks a clean alternating bilingual Word delivery profile; retain the independent English-only reader gates.",
  "selection_evidence": {
    "prior_model_only_result": "A frozen same-source diagnostic comparison preferred T1-OMP by a small margin; it explicitly was not named human adjudication.",
    "new_human_result": "The user reported on 2026-08-28 that the 2026-08-27 human reviews consistently found T1-Codex slightly better than T1-OMP.",
    "decision_rule": "Direct whole-draft human English judgment outranks model aggregate scores, finding counts, backtranslation, length, and mechanical QA when both candidates have passed blocking semantic and structural gates.",
    "scope": "workflow selection only; it does not approve any future translation or waive document-specific human review"
  },
  "source_authority": {
    "file": "source.dj",
    "sole_semantic_authority": true,
    "bridge_is_authoritative": false,
    "semantic_segmentation_is_authoritative": false,
    "controlled_chinese_is_authoritative": false,
    "conflict_resolution": "source.dj wins; unresolved core ambiguity requires a named human decision or blocks drafting"
  },
