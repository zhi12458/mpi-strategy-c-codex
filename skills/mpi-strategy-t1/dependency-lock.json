    "expected_sha": "2805cc742100b1bf294780572c2f65a1ab31567a",
    "compatibility_fork": true,
    "upstream_origin": "https://codeberg.org/eastwind/translation-toolkit.git",
    "upstream_base_sha": "07ebbc90c60c32d9078cceac02d0d502d37b6c0c",
    "submodule_path": "toolkit",
    "required_files": [
      "AGENTS.md",
      "scripts/doctor.py",
      "scripts/source2dj.py",
      "scripts/docx2dj.py",
      "scripts/build-term-map.py",
      "terms-database/search.py",
      "terms-database/termlib.sqlite",
      "scripts/deepseek-source-analysis.py",
